# 本地开发用：复制成 .env 再填。
# 所有配置项都在 config.yml 里，这里**只放 config.yml 中 {{ env.X }} 引用的变量**。
# 线上（Vercel）在 Project Settings → Environment Variables 里配同样的名字。

# ---- 必填 ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=AriaBlogNext
SECRET=请换成一串足够长的随机字符

# ---- 图床（media.enabled=true 时必填，5 个都要） ----
S3_ENDPOINT=
S3_ACCESSKEYID=
S3_SECRETACCESSKEY=
S3_REGION=us-east-1
S3_BUCKET=
S3_PUBLIC_URL=

# ---- 邮件（mail.enabled=true 时必填） ----
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FLINK_ADMIN_EMAIL=

# ---- 友链初筛 / 链路检查（flink.screening.enabled=true 时必填） ----
# GITHUB_REPO 已不再使用：初筛 workflow 就在本仓库，仓库名写死在 config.yml
GH_TOKEN=

# ---- 文章摘要（ai.summary.enabled=true 时必填） ----
SF_TOKEN=

# ---- 语义搜索预留（ai.embedding.enabled=false 时留空即可） ----
EMBEDDING_API_KEY=

# ---- 可选 ----
# CONFIG_FILE=./config.local.yml
# PORT=2333
